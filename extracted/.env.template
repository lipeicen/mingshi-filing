# ============================================================
# 法院自动立案工具 环境配置（真实网站端到端运行前必填）
# 使用方法：把本文件重命名为 .env，放在项目根目录
# （与 test_filing_flow.py 同级），然后在该目录下运行
# ============================================================

# ---------- 必填：人民法院在线服务网 账号 ----------
# 登录 zxfw.court.gov.cn 使用的律师账号（需已完成实名认证）
BEIJING_COURT_USERNAME=请填写账号
BEIJING_COURT_PASSWORD=请填写密码

# ---------- 强烈建议：首次运行保持 true ----------
# true  = 走到「预览和提交」页为止，不真实提交案件
# false = 真实提交（确认预览页信息无误后再改）
COURT_FILING_DRY_RUN=true

# ---------- 可选：默认值覆盖 ----------
# DEFAULT_COURT_NAME=北京市海淀区人民法院
# DEFAULT_CASE_REASON=买卖合同纠纷
# STATE_MAX_AGE_MINUTES=10080

# ---------- 浏览器 ----------
BROWSER_HEADLESS=false
BROWSER_POOL_SIZE=5
BROWSER_TIMEOUT=30000

# ---------- 验证码 ----------
# 优先使用本地 ddddocr（pip install ddddocr），无需 API；
# 本地识别失败时回退打码平台 API，不用可留空
CAPTCHA_API_KEY=
CAPTCHA_API_URL=https://api.captcha-service.com/solve

# ---------- 日志与截图 ----------
LOG_LEVEL=INFO
LOG_FILE=logs/filing.log
SCREENSHOT_DIR=screenshots
DOCUMENT_DIR=documents
